# Copy to .env in this directory. .env is gitignored — never commit it.

# The production host. NOTE: earth-innovators.ae resolves to 31.97.196.73.
# 31.97.196.7 (no trailing 3) is a DIFFERENT machine that also has SSH open —
# it is not this project's server. Do not point this at it.
EARTH_SSH_HOST=31.97.196.73
EARTH_SSH_USER=root

# Absolute path. Node does NOT expand "~", and Git Bash paths like /c/Users/...
# mean nothing to Node on Windows — use forward slashes with the drive letter.
EARTH_SSH_KEY=C:/Users/Lenovo/.ssh/id_rsa
# EARTH_SSH_PASSPHRASE=
# EARTH_SSH_PASSWORD=          # only if no key is installed for this user

# The server listens on 22. The GitHub SSH_PORT secret holds a 5-digit value
# (Hostinger shared hosting uses 65002), which is what made the deploy job
# time out — do not copy that value here.
# EARTH_SSH_PORT=22

# Laravel application root on the server; its .env supplies the DB credentials.
EARTH_APP_DIR=/var/www/earth-innovators
